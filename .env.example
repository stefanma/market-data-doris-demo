# Apache Doris，对应 docker-compose.yml 映射出来的端口。
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=market_data

# Stream Load 会先打到 FE，再被重定向到 BE。
# Docker Desktop（Windows / macOS）上，重定向里的 BE 地址通常是容器网段，宿主机不可达。
# 客户端会把重定向主机改写成下面这个地址，端口对应 compose 里公布的 BE HTTP 端口。
DORIS_BE_HOST=127.0.0.1
DORIS_BE_HTTP_PORT=8040
